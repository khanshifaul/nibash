# Copy to .env for local development. Production secrets are set in Vercel/Render dashboards.

# --- API (apps/api) ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3004

# Database (local Docker by default). Production: Neon/Supabase Postgres connection string.
DATABASE_URL="postgresql://nibash:nibash_dev_password@localhost:5435/nibash?schema=public"
# DIRECT_URL="" # optional direct URL for migrations when DATABASE_URL is pooled

# Auth
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Storage (S3-compatible: Cloudflare R2 recommended for prod, MinIO for local)
STORAGE_ENDPOINT="http://localhost:9001"
STORAGE_REGION="us-east-1" # R2: "auto"
STORAGE_BUCKET="nibash-storage"
STORAGE_ACCESS_KEY_ID="nibash"
STORAGE_SECRET_ACCESS_KEY="nibash_dev_password"
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=""

# Email — Resend (production)
RESEND_API_KEY=""
MAIL_FROM="Nibash <onboarding@resend.dev>"

# SMTP fallback (optional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Web (apps/web) ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3004"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
# Google OAuth client secret — server-side only, never exposed to the browser
GOOGLE_CLIENT_SECRET=""
