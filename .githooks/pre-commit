#!/usr/bin/env bash
set -euo pipefail

# Safe-commit pre-commit hook for nibash
# - blocks secrets/env/credential files and common leak patterns
# - blocks unresolved merge conflict markers in staged content
# - blocks very large staged files
# - runs required checks before commit: biome check, oxlint, typecheck (web/api)

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$ROOT"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR || true)
if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

echo "[pre-commit] checking staged changes..."

# Block committing secret/env files (allow examples/templates)
BLOCKED=0
while IFS= read -r f; do
  [ -z "$f" ] && continue
  base="$(basename "$f")"
  case "$f" in
    *.env.example|*.env*.example|*.env.template|*.env.sample) continue ;;
  esac
  case "$base" in
    .env|.env.local|.env.production|.env.development|.env.test|.env.staging|*.pem|*.key|*.p12|*.pfx|id_rsa|id_ed25519|.deploy-collected.env)
      echo "[pre-commit] ERROR: refusing to commit potential secret/credential file: $f" >&2
      BLOCKED=1
      ;;
  esac
  case "$f" in
    .deploy*.env|*deploy-collected*|*.local.env)
      echo "[pre-commit] ERROR: refusing to commit potential secret/deploy env file: $f" >&2
      BLOCKED=1
      ;;
  esac
done <<< "$STAGED_FILES"

if [ "$BLOCKED" -ne 0 ]; then
  echo "[pre-commit] Unstage/remove secret files before committing." >&2
  exit 1
fi

# Block merge conflict markers in staged content
if git diff --cached -U0 --no-color | grep -nE '^\+ *(<<<<<<< |=======|>>>>>>> )' >/tmp/nibash-conflicts.$$ 2>/dev/null; then
  echo "[pre-commit] ERROR: unresolved merge conflict markers detected in staged changes:" >&2
  head -20 /tmp/nibash-conflicts.$$ >&2 || true
  rm -f /tmp/nibash-conflicts.$$
  exit 1
fi
rm -f /tmp/nibash-conflicts.$$ 2>/dev/null || true

# Block very large staged files (> 5 MB)
MAX_BYTES=$((5 * 1024 * 1024))
while IFS= read -r f; do
  [ -z "$f" ] && continue
  [ -f "$f" ] || continue
  size=$(wc -c < "$f" 2>/dev/null || echo 0)
  if [ "$size" -gt "$MAX_BYTES" ]; then
    echo "[pre-commit] ERROR: staged file too large (>5MB): $f ($size bytes)" >&2
    BLOCKED=1
  fi
done <<< "$STAGED_FILES"
if [ "$BLOCKED" -ne 0 ]; then
  exit 1
fi

fail() {
  echo "[pre-commit] ERROR: $1" >&2
  exit 1
}

run() {
  echo "[pre-commit] $1"
  shift
  "$@"
}

HAS_CODE=0
HAS_WEB=0
HAS_API=0
if echo "$STAGED_FILES" | grep -qE '\.(ts|tsx|js|jsx|mjs|cjs|json|jsonc|css|md)$'; then
  HAS_CODE=1
fi
if echo "$STAGED_FILES" | grep -qE '^apps/web/'; then
  HAS_WEB=1
fi
if echo "$STAGED_FILES" | grep -qE '^apps/api/'; then
  HAS_API=1
fi

# 1) Biome — format + lint + organize imports (project standard)
if [ "$HAS_CODE" -eq 1 ]; then
  if command -v bun >/dev/null 2>&1; then
    run "biome check" bunx biome check . || fail "biome check failed (run: bunx biome check --write .)"
  elif command -v npx >/dev/null 2>&1; then
    run "biome check" npx --yes @biomejs/biome check . || fail "biome check failed"
  else
    fail "bun/npx required for biome"
  fi
fi

# 2) oxlint — additional linting
if [ "$HAS_CODE" -eq 1 ]; then
  if command -v bun >/dev/null 2>&1; then
    run "oxlint" bunx oxlint apps || fail "oxlint failed"
  elif command -v npx >/dev/null 2>&1; then
    run "oxlint" npx --yes oxlint apps || fail "oxlint failed"
  else
    fail "bun/npx required for oxlint"
  fi
fi

# 3) Typecheck — web/api when relevant or when shared config changes
if [ "$HAS_CODE" -eq 1 ]; then
  if command -v bun >/dev/null 2>&1; then
    if [ "$HAS_WEB" -eq 1 ] || [ "$HAS_API" -eq 1 ] || echo "$STAGED_FILES" | grep -qE '^(package\.json|bun\.lock|biome\.json|tsconfig)'; then
      if [ "$HAS_WEB" -eq 1 ] || echo "$STAGED_FILES" | grep -qE '^(package\.json|bun\.lock|biome\.json)'; then
        run "typecheck web (tsc --noEmit)" bash -lc 'cd apps/web && bunx tsc --noEmit' || fail "web typecheck failed"
      fi
      if [ "$HAS_API" -eq 1 ] || echo "$STAGED_FILES" | grep -qE '^(package\.json|bun\.lock|biome\.json)'; then
        run "typecheck api (tsc --noEmit)" bash -lc 'cd apps/api && bunx tsc -p tsconfig.json --noEmit' || fail "api typecheck failed"
      fi
    fi
  else
    fail "bun required for typecheck"
  fi
fi

echo "[pre-commit] OK"
