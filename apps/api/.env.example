NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3004

# Database (Neon/Supabase/Postgres). For Neon pooled runtime + direct migrations, set both.
DATABASE_URL="postgresql://nibash:nibash_dev_password@localhost:5435/nibash?schema=public"
# DIRECT_URL="postgresql://..." # optional: direct/non-pooled URL for prisma migrate deploy

# Auth
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Storage (S3-compatible: Cloudflare R2 / S3 / Backblaze B2 / MinIO)
STORAGE_ENDPOINT="http://localhost:9001"
STORAGE_REGION="us-east-1" # use "auto" for R2
STORAGE_BUCKET="nibash-storage"
STORAGE_ACCESS_KEY_ID="nibash"
STORAGE_SECRET_ACCESS_KEY="nibash_dev_password"
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=""

# Email — Resend preferred (production). If unset, SMTP used when configured, else dev console log.
RESEND_API_KEY=""
MAIL_FROM="Nibash <onboarding@resend.dev>" # verify your domain in Resend for production

# SMTP fallback (optional, legacy)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Google OAuth (optional — enables Google sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="" # e.g. https://<api-host>/auth/google/callback
